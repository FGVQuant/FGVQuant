function criarAbaNewsletter() {
  const ss = SpreadsheetApp.getActive();
  const existente = ss.getSheetByName("Newsletter");
  if (existente) {
    // aba criada antes: atualiza o cabeçalho e preenche só os resumos que ainda estão vazios
    existente.getRange(4, 1, 1, COLUNAS.length).setValues([COLUNAS]);
    const tz = ss.getSpreadsheetTimeZone();
    const ultima = existente.getLastRow();
    const linhas = ultima < 5 ? [] : existente.getRange(5, 1, ultima - 4, COLUNAS.length).getValues();
    let preenchidas = 0;
    linhas.forEach((linha, i) => {
      const edicao = linha[0] instanceof Date ? Utilities.formatDate(linha[0], tz, "MM/yyyy") : String(linha[0]);
      const modelo = NEWSLETTER.find((r) => r[0] === edicao);
      if (!modelo || !modelo[4] || linha[4] !== "") return;
      existente.getRange(i + 5, 4, 1, 5).setValues([modelo.slice(3)]);
      preenchidas++;
    });
    ss.setActiveSheet(existente);
    ss.toast("A aba já existia: cabeçalho atualizado e " + preenchidas + " resumos preenchidos.", "Pronto", 10);
    return;
  }
  const modelo = ss.getSheetByName("Competições");
  const listas = ss.getSheetByName("Listas");
  const aba = ss.insertSheet("Newsletter", listas ? listas.getIndex() - 1 : ss.getNumSheets());

  // mesmo visual das outras abas: título, descrição e cabeçalho copiados de "Competições"
  if (modelo)
    modelo
      .getRange(1, 1, 4, COLUNAS.length)
      .copyTo(aba.getRange(1, 1, 4, COLUNAS.length), SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
  aba.getRange("A1:A2").setValues([
    ["Newsletter"],
    ["Uma linha por edição publicada. Sem 'Resumo', a edição aparece no site como \"resumo em breve\" com o link."],
  ]);
  aba.getRange(4, 1, 1, COLUNAS.length).setValues([COLUNAS]);
  aba.getRange("A5:A").setNumberFormat("@"); // mm/aaaa como texto, sem virar data
  aba.getRange(5, 1, NEWSLETTER.length, COLUNAS.length).setValues(NEWSLETTER);
  [90, 360, 50, 260, 360, 200, 160, 480].forEach((w, i) => aba.setColumnWidth(i + 1, w));
  aba.getRange("E5:E").setWrap(true);
  aba.getRange("H5:H").setWrap(true);
  aba.getRange(5, 1, NEWSLETTER.length, COLUNAS.length).setVerticalAlignment("top");
  aba.setFrozenRows(4);
  ss.setActiveSheet(aba);
  ss.toast("Aba 'Newsletter' criada com " + NEWSLETTER.length + " edições.", "Pronto", 10);
}
